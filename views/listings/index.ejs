<% layout("layouts/boilerplate")%>
<%
  const categoryGuides = [
    { id: "trending", label: "Trending", icon: "fa-fire", title: "A little inspiration for your next escape", description: "Sunlit hideaways, memorable views, and stays worth slowing down for. Explore this week’s hand-picked preview.", image: "https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=1000&q=85", alt: "A cozy mountain cabin beside a peaceful lake", features: ["Hand-picked stays", "Memorable views", "Guest favorites"], limit: 6 },
    { id: "rooms", label: "Rooms", icon: "fa-bed", title: "A room that feels like yours", description: "Find a welcoming room with a comfy bed, a little privacy, and space to recharge after a busy day.", image: "https://images.unsplash.com/photo-1611892440504-42a792e24d32?auto=format&fit=crop&w=1000&q=85", alt: "A bright, comfortable guest room with a neatly made bed", features: ["Comfy beds", "A little privacy", "Easy check-in"] },
    { id: "cities", label: "Iconic Cities", icon: "fa-mountain-city", title: "Stay close to the city buzz", description: "Wake up near famous sights, local cafés, and the streets that make each city special.", image: "https://images.unsplash.com/photo-1519501025264-65ba15a82390?auto=format&fit=crop&w=1000&q=85", alt: "A city skyline glowing at sunset", features: ["Famous sights", "Local food spots", "Easy exploring"] },
    { id: "mountains", label: "Mountains", icon: "fa-mountain", title: "Slow mornings in the mountains", description: "Take in fresh air, big views, and quiet paths far from the rush of everyday life.", image: "https://images.unsplash.com/photo-1506905925346-21bda4d32df4?auto=format&fit=crop&w=1000&q=85", alt: "Tall mountain peaks beneath a clear sky", features: ["Fresh mountain air", "Scenic trails", "Peaceful views"] },
    { id: "castles", label: "Castles", icon: "fa-fort-awesome", title: "A stay with a story", description: "Explore grand old walls, charming details, and places that make a trip feel like a fairytale.", image: "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=1000&q=85", alt: "A historic stone castle surrounded by green hills", features: ["Historic charm", "Unique details", "Storybook views"] },
    { id: "pools", label: "Amazing Pools", icon: "fa-person-swimming", title: "Make a splash, then slow down", description: "Cool off in the water, stretch out in the sun, and make relaxing part of the plan.", image: "https://images.unsplash.com/photo-1572331165267-854da2b10ccc?auto=format&fit=crop&w=1000&q=85", alt: "A clear blue pool ready for a relaxing swim", features: ["A refreshing swim", "Sunny afternoons", "Easy-going days"] },
    { id: "camping", label: "Camping", icon: "fa-campground", title: "Sleep closer to the outdoors", description: "Spend the day outside, gather under the stars, and wake up to nature all around you.", image: "https://images.unsplash.com/photo-1478131143081-80f7f84ca84d?auto=format&fit=crop&w=1000&q=85", alt: "A tent set up at a peaceful forest campsite", features: ["Fresh-air mornings", "Campfire evenings", "Open skies"] },
    { id: "farms", label: "Farms", icon: "fa-cow", title: "A taste of the quiet countryside", description: "Enjoy open fields, slower mornings, and the simple joy of a little extra space.", image: "https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=1000&q=85", alt: "Green fields stretching across the countryside", features: ["Open green spaces", "Quiet mornings", "A slower pace"] },
    { id: "arctic", label: "Arctic", icon: "fa-snowflake", title: "Find wonder in the winter", description: "Wrap up warm, explore snowy landscapes, and look up at the northern lights.", image: "https://images.unsplash.com/photo-1531366936337-7c912a4589a7?auto=format&fit=crop&w=1000&q=85", alt: "Colorful northern lights across a winter night sky", features: ["Snowy scenery", "Cozy evenings", "Northern lights"] },
    { id: "dome", label: "Dome", icon: "fa-igloo", title: "Stay somewhere out of the ordinary", description: "Try a cozy dome stay with a special view and a little more sky overhead.", image: "https://images.unsplash.com/photo-1510798831971-661eb04b3739?auto=format&fit=crop&w=1000&q=85", alt: "A warm wooden hideaway tucked into the forest", features: ["A unique stay", "Nature all around", "Stargazing nights"] },
    { id: "boats", label: "Boats", icon: "fa-ship", title: "Wake up by the water", description: "Enjoy fresh sea air, peaceful water views, and a stay with a different point of view.", image: "https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=1000&q=85", alt: "Gentle ocean waves rolling toward the shore", features: ["Waterfront views", "Sea-air mornings", "A stay with a twist"] }
  ];
%>

<style>
  #filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .filter {
    text-align: center;
    margin-right: 2rem;
    margin-top: 2rem;
    opacity: 0.7;
    color: inherit;
    background: transparent;
    border: 0;
    font: inherit;
    padding: 0;
  }

  button.filter:hover {
    opacity: 1;
    cursor: pointer;
  }

  .filter:focus-visible {
    outline: 2px solid #fe424d;
    outline-offset: 5px;
    border-radius: 0.5rem;
  }

  .filter.is-active {
    color: #fe424d;
    opacity: 1;
  }

  .filter p {
    font-size:0.8rem;
    margin-bottom: 0;
  }

  .tax-info {
    display: none;
  }

  .tax-toggle {
    border: 1px solid black;
    border-radius: 1rem;
    height: 3.25rem;
    padding: 1rem;
    margin-left: 2rem ;
    display: flex;
    align-items: center;
  }
</style>

   
    <div id="filters">
       <% for (const category of categoryGuides) { %>
         <button
           class="filter category-filter"
           type="button"
           data-category="<%= category.id %>"
           data-title="<%= category.title %>"
           data-description="<%= category.description %>"
           data-image="<%= category.image %>"
           data-image-alt="<%= category.alt %>"
           data-features="<%= category.features.join('|') %>"
           data-limit="<%= category.limit || '' %>"
           aria-pressed="false"
         >
           <span><i class="fa-solid <%= category.icon %>" aria-hidden="true"></i></span>
           <p><%= category.label %></p>
         </button>
       <% } %>

       <div class="tax-toggle">
         <div class="form-check-reverse form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
        <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
       </div>
       </div>

       </div>

<section class="trending-preview my-4" id="category-preview" aria-live="polite" hidden>
  <div class="trending-preview-copy">
    <span class="trending-kicker"><i class="fa-solid fa-sparkles"></i> WANDERLUST GUIDE</span>
    <h2 id="category-title"></h2>
    <p id="category-description"></p>
    <ul class="category-features" id="category-features"></ul>
    <span class="trending-count" id="category-note"></span>
  </div>
  <img
    id="category-image"
    src=""
    alt=""
    loading="lazy"
  >
</section>
<p class="category-browse-note" id="category-browse-note" hidden>These are stay ideas, not property filters. Browse all available stays below.</p>

<h2 class="available-stays-heading">Available stays</h2>
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 mt-3" id="listing-grid">
 <% for (let [index, listing] of allListings.entries()) { %>
  <a href="/listings/<%=listing._id %>" class="col listing-link" data-listing-index="<%= index %>">
  <div class="card listing-card">
    <img src="<%= listing.image.url %>" class="card-img-top" alt="Image for <%= listing.title %>" style="height: 20rem;">
      <div class="card-img-overlay"></div>
    <div class="card-body">
      <b class="card-title"><%= listing.title %></b>
      <p class="card-text">&#8377; <%=  listing.price != null ?listing.price.toLocaleString("en-IN"): "N/A" %> / night 
      <i class="tax-info">&nbsp; &nbsp; +18% GST</i></p>
    </div>
  </div>
  </a> 
<% } %>
 
</div>

<script>
  const taxSwitch = document.getElementById("flexSwitchCheckDefault");
  taxSwitch.addEventListener("change", () => {
    const taxInfo = document.getElementsByClassName("tax-info");
    for (const info of taxInfo) {
      if (taxSwitch.checked) {
      info.style.display = "inline";
      } else {
      info.style.display = "none";
      }
    }
  });

  const categoryFilters = [...document.querySelectorAll(".category-filter")];
  const categoryPreview = document.getElementById("category-preview");
  const categoryTitle = document.getElementById("category-title");
  const categoryDescription = document.getElementById("category-description");
  const categoryImage = document.getElementById("category-image");
  const categoryFeatures = document.getElementById("category-features");
  const categoryNote = document.getElementById("category-note");
  const browseNote = document.getElementById("category-browse-note");
  const listingCards = [...document.querySelectorAll("[data-listing-index]")];
  let selectedCategory = null;

  categoryFilters.forEach((filter) => {
    filter.addEventListener("click", () => {
      selectedCategory = selectedCategory === filter ? null : filter;
      categoryFilters.forEach((categoryFilter) => {
        const isActive = categoryFilter === selectedCategory;
        categoryFilter.classList.toggle("is-active", isActive);
        categoryFilter.setAttribute("aria-pressed", String(isActive));
      });

      if (!selectedCategory) {
        categoryPreview.hidden = true;
        browseNote.hidden = true;
        listingCards.forEach((card) => { card.hidden = false; });
        return;
      }

      const { title, description, image, imageAlt, features, limit } = selectedCategory.dataset;
      const sampleLimit = limit ? Math.min(Number(limit), listingCards.length) : null;
      categoryTitle.textContent = title;
      categoryDescription.textContent = description;
      categoryImage.src = image;
      categoryImage.alt = imageAlt;
      categoryNote.textContent = sampleLimit
        ? `${sampleLimit} sample stays to explore`
        : "Browse all available stays below";
      categoryFeatures.replaceChildren();
      features.split("|").forEach((feature) => {
        const tag = document.createElement("li");
        tag.textContent = feature;
        categoryFeatures.append(tag);
      });
      categoryPreview.hidden = false;
      browseNote.hidden = Boolean(sampleLimit);
      listingCards.forEach((card, index) => {
        card.hidden = Boolean(sampleLimit && index >= sampleLimit);
      });
      categoryPreview.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });
</script>
